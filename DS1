k#include <iostream>
using namespace std;

int main()
{
    int arr[50], n, choice, pos, value;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++)
        cin >> arr[i];

    cout << "\n1. Insert\n2. Delete\n3. Display\n";
    cout << "Enter choice: ";
    cin >> choice;

    if (choice == 1)
    {
        cout << "Enter position: ";
        cin >> pos;
        cout << "Enter value: ";
        cin >> value;

        for (int i = n; i >= pos; i--)
            arr[i] = arr[i - 1];

        arr[pos - 1] = value;
        n++;
    }
    else if (choice == 2)
    {
        cout << "Enter position to delete: ";
        cin >> pos;

        for (int i = pos - 1; i < n - 1; i++)
            arr[i] = arr[i + 1];

        n--;
    }

    cout << "Array: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}